   ],
   "source": [
    "import numpy as np\n",
    "w, b, x = np.array([0.4, -0.7]), 0.1, np.array([2.0, 1.0])\n",
    "f = float(np.dot(w, x) + b)\n",
    "print(f\"f = {f:.4f}, lop {\"+1\" if f > 0 else \"-1\"}\")\n",
    "print(\"Khoang cach = %.6f\" % (abs(f) / np.linalg.norm(w)))\n",
    "print(\"be rong le = %.6f\" % (2.0 / np.linalg.norm(w)))"
   ]
  }
 ],
